(defwindow bar
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0px"
                               :width "100%"
                               :height "30px"
                               :anchor "top center")
           :stacking "fg"
           :exclusive true
           (box :orientation "horizontal"
                :halign "center"
           (clock)
           )

)

(defpoll time :interval "1s"
  `date "+%H:%M:%S"`)

(defwidget clock []
  (label :text time))
